# Bank statement cheque matching (backend only; never expose this key to Vite)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000

# Public QR receipt verification (server-only signing key)
RECEIPT_VERIFY_SECRET=replace-with-a-long-random-secret
PUBLIC_VERIFY_URL=https://defencegarden.com/verify-receipt

# KYC/document OCR. When OpenRouter is selected, PDF parsing and model usage are
# both billed through the configured OpenRouter account.
DMS_OCR_ENGINE=openrouter
DMS_OCR_TIMEOUT_MS=120000
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OPENROUTER_KYC_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OPENROUTER_PDF_ENGINE=mistral-ocr
KYC_AI_ENGINE=openrouter
