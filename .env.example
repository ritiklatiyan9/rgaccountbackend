# Bank statement cheque matching (backend only; never expose this key to Vite)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000

# Public QR receipt verification (server-only signing key)
RECEIPT_VERIFY_SECRET=replace-with-a-long-random-secret
PUBLIC_VERIFY_URL=https://dgbooking.com/verify-receipt

# KYC/document OCR. When OpenRouter is selected, PDF parsing and model usage are
# both billed through the configured OpenRouter account.
DMS_OCR_ENGINE=openrouter
DMS_OCR_TIMEOUT_MS=120000
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OPENROUTER_KYC_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_KYC_PDF_ENGINE=native
OPENROUTER_PDF_ENGINE=mistral-ocr
KYC_AI_ENGINE=openrouter

# AWS object storage. Prefer an IAM role on the API host instead of long-lived keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Optional read-only credentials for receipts created before an S3 migration.
LEGACY_AWS_REGION=
LEGACY_AWS_ACCESS_KEY_ID=
LEGACY_AWS_SECRET_ACCESS_KEY=
LEGACY_AWS_S3_BUCKET_NAME=

# AWS client messaging (Management Analytics > Client Messages)
AWS_MESSAGING_QUEUE_REGION=ap-south-1
AWS_CLIENT_MESSAGE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/044986460213/client-messages-dlq

# Amazon SES email
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=updates@example.com
AWS_SES_CONFIGURATION_SET=

# AWS End User Messaging SMS
AWS_SMS_REGION=ap-south-1
AWS_SMS_ORIGINATION_IDENTITY=
AWS_SMS_CONFIGURATION_SET=
AWS_SMS_PROTECT_CONFIGURATION_ID=np
# Required for local India routes; values come from your DLT registration.
AWS_SMS_ENTITY_ID=
AWS_SMS_TEMPLATE_ID=

# Accountancy WhatsApp Studio (independent of the Booking worker).
# First apply migrations 225 and 226, then configure the sender. Each event still needs
# an approved template explicitly applied and its automation enabled in Studio.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AWS_REGION=ap-south-1
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_META_API_VERSION=v23.0
# Optional dedicated credentials; otherwise the normal AWS credential chain is used.
WHATSAPP_AWS_ACCESS_KEY_ID=
WHATSAPP_AWS_SECRET_ACCESS_KEY=
# Existing private WhatsApp S3 media bucket in the sender AWS account and region.
WHATSAPP_MEDIA_BUCKET=

# Optional admin login OTP. Leave disabled until the SMTP credentials have been
# verified; normal password and Google login continue to work when it is false.
LOGIN_OTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# Native backups: apply migration 249 and deploy the separate worker first.
# See docs/BACKUP_SYSTEM.md. No API-process generation; no Redis required.
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=accounts-native-backups
BACKUP_KMS_KEY_ID=
# Direct/unpooled DB endpoint with verified TLS, same database as the API.
# Omit to use DB_*; use secrets management for credentials.
BACKUP_DATABASE_URL=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_ATTEMPTS=3
BACKUP_LEASE_SECONDS=90
BACKUP_TIMEOUT_MS=21600000
BACKUP_POLL_MS=3000
BACKUP_COMPRESSION=1
BACKUP_PART_MIB=8
BACKUP_UPLOAD_CONCURRENCY=2
BACKUP_MAX_ARCHIVE_GIB=50
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
BACKUP_PG_SSL_ROOT_CERT=
# Enable immutable-retained only after enforcing immutable file keys and delayed
# deletion across every writer; local uploads must be available read-only here.
BACKUP_FILES_POLICY=
BACKUP_LOCAL_ROOT=
# Optional EMPTY local backup_verify_* database owned by a non-superuser.
BACKUP_RESTORE_DATABASE_URL=

# Legacy JSON imports are disabled by default. Restores require maintenance mode
# and restart of EVERY API; stop connected apps and the native backup worker too.
BACKUP_LEGACY_RESTORE_ENABLED=false
BACKUP_MAINTENANCE_MODE=false
# These bounded legacy import limits do not apply to native backup generation.
# Legacy JSON decoding still uses memory; never raise limits for large restores.
BACKUP_MAX_UPLOAD_MB=100
BACKUP_MAX_EXPANDED_MB=100
# Originals stream into parts of at most 24 MiB raw contents (3 MiB chunks).
# Private disk must accommodate retained exports and incomplete restore sets.
# Set limits do not raise the archive decompression/upload limits above.
BACKUP_MAX_ATTACHMENT_SET_MB=2048
BACKUP_MAX_ATTACHMENT_FILE_MB=512
# Expensive wallet reads are limited on the database server. This setting
# applies only to wallet reads, not financial writes or migrations (max 30000).
WALLET_READ_TIMEOUT_MS=8000
WALLET_READ_CONCURRENCY=2

# Per API/worker process. Keep the existing pool size until the deployment's
# database memory, instance count and other applications' connections are known.
# Total connection budget includes every process using this same database.
DB_POOL_MAX=10
DB_POOL_MAX_WAITING=64
DB_CONNECTION_TIMEOUT_MS=10000
# KPI/chart reads share at most two running queries and a bounded pending queue.
# Expired queued reads never reach PostgreSQL. These limits do not cancel writes.
FINANCIAL_READ_MAX_PENDING=32
FINANCIAL_READ_QUEUE_TIMEOUT_MS=5000
# Opt-in route latency/query counts, pool occupancy and RSS; excludes SQL,
# financial values, user identities, headers, query strings and request bodies.
API_PERFORMANCE_LOG=false

# My Real Assets customer API (/api/mobile). Use a separate random secret of
# at least 32 characters in production. If omitted, a domain-separated key is
# derived from JWT_ACCESS_SECRET; staff JWTs cannot authenticate here.
MOBILE_PORTAL_SECRET=

# WhatsApp marketing and inbox. Campaigns start only from the manual Send action.
# The same WHATSAPP_* sender/media credentials used by Studio are reused.
WHATSAPP_INBOX_ORGANIZATION_ID=
WHATSAPP_INBOX_AWS_ACCOUNT_ID=
# Comma-separated allowlist supported with WHATSAPP_SNS_TOPIC_ARNS instead.
WHATSAPP_SNS_TOPIC_ARN=
# Optional private SQS subscription for incoming messages on localhost/workers.
# Keep SNS RawMessageDelivery=false so signatures can be verified.
WHATSAPP_INBOX_QUEUE_URL=
# Local preview only: an existing trusted sender environment, kept server-side.
ACCOUNT_WHATSAPP_SHARED_SENDER_ENV=
ACCOUNT_WHATSAPP_PREVIEW_PORT=8010
ACCOUNT_WHATSAPP_CAMPAIGN_WORKER=false
