# Bank statement cheque matching (backend only; never expose this key to Vite)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000

# Public QR receipt verification (server-only signing key)
RECEIPT_VERIFY_SECRET=replace-with-a-long-random-secret
PUBLIC_VERIFY_URL=https://defencegarden.com/verify-receipt
