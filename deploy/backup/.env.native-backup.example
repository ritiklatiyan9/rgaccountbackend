# Copy settings into the secret manager/service environment; do not commit secrets.
# These examples do not start a worker, create cloud resources or modify a database.
BACKUP_ENABLED=false
# 'separate' for a dedicated process/service; 'shared' uses existing web compute.
# Shared mode requires a rebuild and unset BACKUP_PG_DUMP/BACKUP_PG_RESTORE.
BACKUP_WORKER_MODE=separate
# Same business/control database as the API, DIRECT PostgreSQL endpoint, verified TLS.
BACKUP_DATABASE_URL=postgresql://BACKUP_ROLE:SECRET@DIRECT_HOST:5432/DATABASE?sslmode=verify-full
BACKUP_S3_BUCKET=REPLACE_BACKUP_BUCKET
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=accounts-native-backups
# Prefer the deployment's IAM role. No access keys belong in this template.
# For separate scoped identities, configure these four names in the secret manager:
# BACKUP_WORKER_AWS_ACCESS_KEY_ID, BACKUP_WORKER_AWS_SECRET_ACCESS_KEY,
# BACKUP_DOWNLOAD_AWS_ACCESS_KEY_ID, BACKUP_DOWNLOAD_AWS_SECRET_ACCESS_KEY.
BACKUP_KMS_KEY_ID=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_ATTEMPTS=3
BACKUP_LEASE_SECONDS=90
BACKUP_TIMEOUT_MS=21600000
BACKUP_POLL_MS=3000
BACKUP_COMPRESSION=1
BACKUP_PART_MIB=8
BACKUP_UPLOAD_CONCURRENCY=2
# Shared mode forces concurrency=1; set BACKUP_PART_MIB=5 for its smaller budget.
BACKUP_MAX_ARCHIVE_GIB=50
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
BACKUP_PG_SSL_ROOT_CERT=
# Enable only after ALL file writers use immutable keys and delayed deletion.
BACKUP_FILES_POLICY=
# Container mount of the API upload tree, read-only when capture is enabled.
BACKUP_LOCAL_ROOT=/app
# Fresh local backup_verify_* DB, owned by a non-superuser, never production.
BACKUP_RESTORE_DATABASE_URL=
BACKUP_LEGACY_RESTORE_ENABLED=false
BACKUP_MAINTENANCE_MODE=false
