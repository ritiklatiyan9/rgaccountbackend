{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyBackupPrefixForAttemptCleanup",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BACKUP_BUCKET",
      "Condition": {
        "StringLike": { "s3:prefix": ["accounts-native-backups/*"] }
      }
    },
    {
      "Sid": "CreateVerifyAndCleanBackupArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject", "s3:GetObject", "s3:DeleteObject",
        "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BACKUP_BUCKET/accounts-native-backups/*"
    }
  ]
}
