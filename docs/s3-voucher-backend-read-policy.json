{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccountsBackendReadVouchers",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::550433064691:user/ritik"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mountreality/vouchers/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
