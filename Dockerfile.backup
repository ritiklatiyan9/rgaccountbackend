FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

# Matching native PostgreSQL tools and their shared libraries. Build/pin image
# digests in your release pipeline; this is a separate worker, not the web API.
FROM postgres:18-bookworm
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
USER postgres
ENTRYPOINT []
CMD ["node", "--max-old-space-size=192", "src/workers/backupWorker.js"]
